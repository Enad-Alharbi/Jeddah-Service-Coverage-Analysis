<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Same secret store as the API, so the Oracle connection string is set only once. -->
    <UserSecretsId>244c3ae8-fa17-44fd-8381-aecdd9e88322</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="11.0.0" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.400" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>

</Project>
